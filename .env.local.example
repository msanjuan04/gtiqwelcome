# ==========================================================================
# GTiQ — Variables de entorno
# Copia este archivo a `.env.local` y rellena los valores. NO subas .env.local
# al repositorio.
# ==========================================================================

# API key de Resend (obligatoria para que funcione el formulario)
# Obtenla en https://resend.com/api-keys
RESEND_API_KEY=re_fVZA19mi_JhxS5wvPQdqGALMHXFDunAtD

# Dirección a la que llegan las solicitudes del formulario.
# Acepta varios destinatarios separados por comas.
LEAD_TO_EMAIL=hola@gtiq.app

# Remitente que aparece en el email enviado.
# Tiene que ser una dirección de un dominio verificado en Resend.
# Mientras no verifiques tu dominio puedes dejarlo vacío y se usará
# el remitente sandbox `onboarding@resend.dev` (solo válido para pruebas).
LEAD_FROM_EMAIL=GTiQ <noreply@gtiq.app>
